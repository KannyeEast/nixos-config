// @TODO: Trial and error approach. Test and figure out what feels right.
// - Look into scripts
// - Switch events can also go in here if neededl.
binds {
    // ── applications ────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn "fuzzel"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "zen-beta"; }
    Mod+E hotkey-overlay-title="Files" { spawn "nautilus"; }
    Mod+P hotkey-overlay-title="Passwords" { spawn "keepassxc"; }

    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "swaylock"; }

    // ── window ────────
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+V hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Focus Floating / Tiling" { switch-focus-between-floating-and-tiling; }
    Mod+W hotkey-overlay-title="Toggle Tabbed Column" { toggle-column-tabbed-display; }

    Mod+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+M hotkey-overlay-title="Maximize to Edges" { maximize-window-to-edges; }
    Mod+Ctrl+F hotkey-overlay-title="Expand Column to Free Space" { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }

    Mod+R hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Cycle Column Width Back" { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Cycle Window Height" { switch-preset-window-height; }
    Mod+Ctrl+R hotkey-overlay-title="Reset Window Height" { reset-window-height; }

    Mod+Minus hotkey-overlay-title="Narrower Column" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Wider Column" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Shorter Window" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Taller Window" { set-window-height "+10%"; }

    // ── focus ────────
    Mod+H hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+J hotkey-overlay-title="Focus Window Down" { focus-window-down; }
    Mod+K hotkey-overlay-title="Focus Window Up" { focus-window-up; }
    Mod+L hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Home hotkey-overlay-title="Focus First Column" { focus-column-first; }
    Mod+End hotkey-overlay-title="Focus Last Column" { focus-column-last; }

    // ── move ────────
    Mod+Ctrl+H hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Ctrl+J hotkey-overlay-title="Move Window Down" { move-window-down; }
    Mod+Ctrl+K hotkey-overlay-title="Move Window Up" { move-window-up; }
    Mod+Ctrl+L hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Ctrl+Home hotkey-overlay-title="Move Column to Start" { move-column-to-first; }
    Mod+Ctrl+End hotkey-overlay-title="Move Column to End" { move-column-to-last; }

    // ── columns ────────
    Mod+BracketLeft hotkey-overlay-title="Consume or Expel Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume or Expel Right" { consume-or-expel-window-right; }
    Mod+Comma hotkey-overlay-title="Consume Window into Column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Expel Window from Column" { expel-window-from-column; }

    // ── workspaces ────────
    Mod+U hotkey-overlay-title="Workspace Down" { focus-workspace-down; }
    Mod+I hotkey-overlay-title="Workspace Up" { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }

    Mod+Ctrl+U hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Ctrl+I hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+Shift+U hotkey-overlay-title="Move Workspace Down" { move-workspace-down; }
    Mod+Shift+I hotkey-overlay-title="Move Workspace Up" { move-workspace-up; }

    // Left untitled on purpose: nine near-identical rows would bury the
    // rest of the overlay, and the pattern is obvious once you know one.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ── monitors ────────
    Mod+Shift+H hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Shift+J hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Shift+K hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Shift+L hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+H hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ── scroll ────────
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }

    // ── screenshots ────────
    Print hotkey-overlay-title="Screenshot Selection" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="Screenshot Window" { screenshot-window; }

    // ── media ────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // ── session ────────
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcut Inhibit" { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }
    Ctrl+Alt+Delete { quit; }
}
