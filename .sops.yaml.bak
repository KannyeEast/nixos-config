keys:
  - &users: # nix-shell -p ssh-keygen -t ed25519 -f /home/<user>/.ssh/<user>
    - &admin <age key>
    - &user <age key>
  - &hosts: # nix-shell -p ssh-to-age --run 'cat /etc/ssh/ssh_host_ed25519_key.pub | ssh-to-age'
    - &default <age key>
creation_rules:
  - path_regex: hosts/default/secrets.yaml$
    key_groups:
      - age:
          - *admin
          - *user
          - *default